# openai or anthropic. If empty, the server picks whichever key exists.
# If neither key exists and MOCK_LLM is unset, the app runs in mock mode.
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional. Used only when the name matches the active provider (gpt-* / claude-*).
LLM_MODEL=

# 1 = always return a local sample, no API call.
# 0 = never mock; missing keys return an error.
# unset = mock only when no API key is configured.
MOCK_LLM=1
